#!name=YouTube Music 歌词中文翻译
#!desc=v40 YouTube Music 歌词翻译成简体中文（原文下方显示译文）。中文歌词（简体/繁体）不翻译，没有歌词的歌曲不处理。与「YouTube 自动简中双语字幕」模块完全独立，可单独开关。
#!author=Hey-sayiwanna
#!homepage=https://github.com/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge
#!icon=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge/main/src/assets/icon_rounded.png
#!category=YouTube
#!version=40.0
#!arguments=显示方式:原文在上,避让Enhance:true
#!arguments-desc=显示方式：原文在上 / 译文在上 / 仅译文\n避让Enhance：Surge 每个请求只运行一个响应脚本。开启后歌词请求改用等价的「:443」显式端口地址，避免被「Youtube (Music) Enhance」等模块的 youtube.response 抢走；没装这类模块也可以保持开启。

[Script]
# 1) 请求：只在歌词请求（browseId 以 MPLYt_ 开头）上打标记 ytmLyrics=1，请求体原样转发
YTMusic.Lyrics.request.proto = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$, requires-body=1, binary-body-mode=1, max-size=-1, engine=jsc, timeout=5, script-path=https://cdn.jsdelivr.net/gh/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge@main/YouTubeMusic.Lyrics.request.bundle.js, argument="Position={{{显示方式}}}&Evade={{{避让Enhance}}}"
YTMusic.Lyrics.request.json = type=http-request, pattern=^https:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.*)?$, requires-body=1, max-size=-1, engine=jsc, timeout=5, script-path=https://cdn.jsdelivr.net/gh/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge@main/YouTubeMusic.Lyrics.request.bundle.js, argument="Position={{{显示方式}}}&Evade={{{避让Enhance}}}"
# 2) 响应：只处理打过标记的歌词响应
YTMusic.Lyrics.response.proto = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com(:443)?\/youtubei\/v1\/browse\?(.*&)?ytmLyrics=1, requires-body=1, binary-body-mode=1, max-size=-1, timeout=30, script-path=https://cdn.jsdelivr.net/gh/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge@main/YouTubeMusic.Lyrics.response.bundle.js, argument="Position={{{显示方式}}}&Evade={{{避让Enhance}}}"
YTMusic.Lyrics.response.json = type=http-response, pattern=^https:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*&)?ytmLyrics=1, requires-body=1, max-size=-1, timeout=30, script-path=https://cdn.jsdelivr.net/gh/Hey-sayiwanna/YouTube-Bilingual-Subtitles-Surge@main/YouTubeMusic.Lyrics.response.bundle.js, argument="Position={{{显示方式}}}&Evade={{{避让Enhance}}}"

[MITM]
hostname = %APPEND% youtubei.googleapis.com, music.youtube.com
