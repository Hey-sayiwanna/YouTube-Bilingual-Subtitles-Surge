+
+/* ------------------------------------------------------------------------ */
+/* 1. Word extraction                                                        */
+/* ------------------------------------------------------------------------ */
+
+const EVENT_RE = /^\s*(?:\[[^\]]{1,40}\]|\([^)]{1,40}\)|[♪♫♬\s]+)\s*$/u;
