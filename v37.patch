+			`A:${a1}|${a0}`, `B:${a0}|${b0}`, `C:${b0}|${b1}`,
+			`D:${a0}|${b0}|${b1}`, `E:${a1}|${a0}|${b0}`,
+			`t:${x0}`, `u:${y0}`,
+			`TA:${x1}|${x0}`, `TB:${x0}|${y0}`, `TC:${y0}|${y1}`,
+			`TD:${y0}|${y1}|${y2}`, `TE:${x0}|${y0}|${y1}`,
+			`TF:${y0}|${y1}|${y2}|${y3}`,
+			`TG:${x1}|${x0}|${y0}|${y1}`,
