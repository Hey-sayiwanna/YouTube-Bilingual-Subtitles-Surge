+			// Spanning a hard gap is only allowed for a short orphan on one side.
+			let anchorStart = start;
+			let anchorEnd = end;
+			if (hardGaps.length) {
+				if (hardGaps.length > 1) break;
+				const gapIndex = hardGaps[0];
+				const before = gapIndex - start + 1;
+				const after = end - gapIndex;
